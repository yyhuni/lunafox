# SPDX-License-Identifier: GPL-3.0-only
# LunaFox public Compose deployment configuration.
#
# GENERATED / READ-ONLY in this repository: the private source is the only
# writer of this file, so never edit it in a checkout. The deployment package
# ships the same content as both `.env` and `.env.example`, so no copy step is
# required: edit the live `.env` beside compose.yaml in place.
# Keep this template and your live file free of secret edits; never commit local secret edits.

# Active settings
# Review these settings before the first start.

# Product image Registry authority (host[:port], without scheme or path).
# Official sources: docker.io or ghcr.io. Custom mirrors preserve paths/digests.
RELEASE_REGISTRY=docker.io

# Optional independent source for Engine Packages and Runtime Images.
# Empty uses RELEASE_REGISTRY. Mirrors must also carry OCI signature referrers.
ENGINE_INSTALL_REGISTRY=

# Public HTTPS address. PUBLIC_PORT accepts any free port from 1 to 65535.
PUBLIC_HOST=localhost
PUBLIC_PORT=443

# Database deployment mode. Keep embedded to use the bundled PostgreSQL, or set
# external to connect to a database you operate yourself.
DATABASE_MODE=embedded

# Optional: external database
# Only used when DATABASE_MODE=external. Uncomment the entries and set them to
# your server's values. DB_SSLMODE must be set in external mode; prefer require,
# verify-ca, or verify-full for a remote server.

#DB_HOST=database.example
#DB_PORT=5432
#DB_USER=postgres
#DB_NAME=lunafox
#DB_SSLMODE=require

# Optional: session time zone and connection pool
# Uncomment a line to replace its default. These apply in embedded and external
# mode. A later start picks up edits; they are not locked after the first start.
# DB_TIMEZONE is the PostgreSQL session time zone. DB_CONN_MAX_LIFETIME is seconds.
#DB_TIMEZONE=UTC
#DB_MAX_OPEN_CONNS=25
#DB_MAX_IDLE_CONNS=5
#DB_CONN_MAX_LIFETIME=300

# Internal inputs
# compose.yaml declares these two names as environment-backed secrets, so the
# empty assignments below must stay in place or containers fail to start.

# Leave empty in embedded mode to generate and persist a password on first
# start. External mode requires the remote database password for the first
# initialization.
DB_PASSWORD=

# Leave empty to generate and persist a secret on first start.
JWT_SECRET=

# Derived values, do not edit
# The Compose profile selects the service graph and must follow DATABASE_MODE.
# Startup fails when the two values disagree.
COMPOSE_PROFILES=${DATABASE_MODE:-embedded}

# Release-bound image preheat identity. Generated with this package; do not edit.
LUNAFOX_PREHEAT_MANIFEST_DIGEST=sha256:683dff5778f7c24c09b113a8f7639c6627eb2e18872fa3efd72d2933b5077691
