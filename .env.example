# GENERATED / READ-ONLY deployment template.
# Review the public endpoint before starting. Never commit .env.
PUBLIC_HOST=localhost
PUBLIC_PORT=443

# Optional database identity. Empty values use the defaults shown here.
DB_USER=postgres
DB_NAME=lunafox

# Optional first-start inputs. Empty values are generated once and persisted in
# the lunafox_config volume. Use single quotes for values containing $, # or spaces.
DB_PASSWORD=
JWT_SECRET=
