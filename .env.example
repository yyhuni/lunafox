# SPDX-License-Identifier: GPL-3.0-only
# GENERATED / READ-ONLY template for the public Compose deployment.
# install.sh creates .env atomically with mode 0600. Do not commit .env.

# Selected from channels/<channel>.env and manifests/<version>.yaml.
# Every product and bootstrap reference is immutable and digest-qualified.
# SERVER_IMAGE_REF=docker.io/yyhuni/lunafox-server@sha256:<64 lowercase hex>
# FRONTEND_IMAGE_REF=docker.io/yyhuni/lunafox-frontend@sha256:<64 lowercase hex>
# NGINX_IMAGE_REF=docker.io/yyhuni/lunafox-nginx@sha256:<64 lowercase hex>
# AGENT_IMAGE_REF=docker.io/yyhuni/lunafox-agent@sha256:<64 lowercase hex>
# BOOTSTRAP_IMAGE_REF=docker.io/yyhuni/lunafox-bootstrap@sha256:<64 lowercase hex>

# Release and public endpoint.
# RELEASE_VERSION=0.0.1-alpha.55
# AGENT_VERSION=0.0.1-alpha.55
# PUBLIC_HOST=example.invalid
# PUBLIC_URL=https://example.invalid
# PUBLIC_PORT=443
# RELEASE_MANIFEST_PATH=manifests/v0.0.1-alpha.55.yaml
# ENGINE_INVENTORY_HOST_PATH=.lunafox/engine-inventory.yaml
# ENGINE_INSTALL_REGISTRY=docker.io
# LOKI_PUSH_URL=https://example.invalid/loki/api/v1/push

# Host-owned credentials generated by install.sh.
# JWT_SECRET=<64 lowercase hex>
# DB_PASSWORD=<generated password>
# DB_USER=postgres
# DB_NAME=lunafox
# DB_HOST=postgres
# DB_PORT=5432
# DB_SSLMODE=disable
# DB_TIMEZONE=UTC
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_DB=0

# Runtime defaults.
# SERVER_PORT=8080
# SERVER_GRPC_PORT=9090
# GIN_MODE=release
# LOG_LEVEL=info
# WORDLISTS_BASE_PATH=/opt/lunafox/wordlists
# ENGINE_PACKAGE_CACHE_ROOT=/opt/lunafox/engine-packages
# FINGERPRINT_ARTIFACTS_BASE_PATH=/opt/lunafox/fingerprint-artifacts
# LOGIN_VISUALS_BASE_PATH=/opt/lunafox/login-visuals
# WORKFLOW_DEFINITIONS_ROOT=/usr/local/share/lunafox/workflows
