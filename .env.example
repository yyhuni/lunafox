# SPDX-License-Identifier: GPL-3.0-only
# GENERATED / READ-ONLY deployment template.
# Review the public endpoint before starting. Never commit .env.
PUBLIC_HOST=localhost
PUBLIC_PORT=443

# Database deployment mode. Keep COMPOSE_PROFILES derived from DATABASE_MODE.
# For an external database, also set DB_HOST, DB_SSLMODE, and DB_PASSWORD.
DATABASE_MODE=embedded
COMPOSE_PROFILES=${DATABASE_MODE:-embedded}

# Database connection. Empty Port, User, and Name values use these defaults.
DB_HOST=
DB_PORT=5432
DB_USER=postgres
DB_NAME=lunafox
DB_SSLMODE=

# Embedded mode can generate DB_PASSWORD. External mode requires the remote
# database's existing password on first initialization. JWT_SECRET is generated
# when empty. Use single quotes for values containing $, # or spaces.
DB_PASSWORD=
JWT_SECRET=
