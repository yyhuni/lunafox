{
  "manifestVersion": "engine.v5",
  "engineId": "engine.lunafox.screenshot",
  "publisher": "lunafox",
  "execution": {
    "engineApiMajor": 2,
    "supportedTargetTypes": [
      "domain",
      "ip",
      "cidr"
    ],
    "configSections": [
      {
        "id": "capture",
        "defaultEnabled": true,
        "params": [
          {
            "key": "page-timeout",
            "type": "integer",
            "default": 15,
            "minimum": 1,
            "maximum": 120
          },
          {
            "key": "concurrency",
            "type": "integer",
            "default": 5,
            "minimum": 1,
            "maximum": 20
          },
          {
            "key": "retries",
            "type": "integer",
            "default": 1,
            "minimum": 0,
            "maximum": 3
          }
        ]
      }
    ]
  }
}
