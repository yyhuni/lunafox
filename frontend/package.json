{
  "name": "lunafox",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "next dev --turbo",
    "dev:mock": "NEXT_PUBLIC_USE_MOCK=true next dev --turbo",
    "dev:mock:noauth": "NEXT_PUBLIC_USE_MOCK=true NEXT_PUBLIC_SKIP_AUTH=true next dev --turbo",
    "dev:noauth": "NEXT_PUBLIC_SKIP_AUTH=true next dev --turbo",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "lint:core": "eslint hooks services types lib components/shared/data-table components/target components/organization components/scan/scheduled --max-warnings 0",
    "check:ui-boundary": "node scripts/check-ui-boundary.mjs --mode verify",
    "check:typography-foundation": "node scripts/check-typography-foundation.mjs --mode verify",
    "check:color-foundation": "node scripts/check-color-foundation.mjs --mode verify",
    "check:spacing-foundation": "node scripts/check-spacing-foundation.mjs --mode verify",
    "check:button-foundation": "node scripts/check-button-foundation.mjs --mode verify",
    "check:component-foundation": "node scripts/check-component-foundation.mjs --mode verify",
    "check:a11y-foundation": "node scripts/check-a11y-foundation.mjs --mode verify",
    "check:motion-foundation": "node scripts/check-motion-foundation.mjs --mode verify",
    "check:loading-foundation": "node scripts/check-loading-foundation.mjs --mode verify",
    "check:ui-foundation": "node scripts/check-ui-foundation.mjs --mode verify",
    "check:service-mock-mode": "node scripts/check-service-mock-mode.mjs --mode verify",
    "check:foundation-ledger": "node scripts/report-foundation-ledger.mjs",
    "check:datatable-legacy": "bash scripts/check-datatable-legacy-props.sh",
    "test:e2e:routes": "SMOKE_INCLUDE_PASSED=1 SMOKE_REQUIRE_TARGETS=1 SMOKE_CONCURRENCY=1 node scripts/run-route-smoke.mjs",
    "test:e2e:interaction": "INTERACTION_STRICT=1 node scripts/run-interaction-smoke.mjs",
    "test:e2e:fingerprints": "node scripts/run-fingerprint-ui-smoke.mjs",
    "test:e2e:loading": "LOADING_SMOKE_PRIORITY=P0,P1,P2 LOADING_SMOKE_CONCURRENCY=2 LOADING_SMOKE_INTERACTIONS=off node scripts/run-loading-handoff-smoke.mjs",
    "test:e2e:loading:mobile": "LOADING_SMOKE_PRIORITY=P0,P1,P2 LOADING_SMOKE_CONCURRENCY=2 LOADING_SMOKE_INTERACTIONS=off LOADING_SMOKE_VIEWPORT=mobile node scripts/run-loading-handoff-smoke.mjs",
    "test:e2e:visual:baseline": "node scripts/build-refactor-visual-baseline.mjs",
    "test:e2e:inventory": "node scripts/build-interaction-matrix.mjs",
    "test:e2e:perf:probe": "node scripts/run-performance-probe.mjs",
    "test:e2e:perf:diagnostics": "node scripts/normalize-browser-diagnostics.mjs",
    "test:e2e:boundary:plan": "node scripts/build-boundary-todo.mjs",
    "test:e2e:full:loop": "node scripts/run-full-coverage-loop.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@codemirror/commands": "^6.10.1",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.12.1",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.12",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.2.2",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.18",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react-simple-maps": "3.0.6",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.0.0",
    "ansi-to-html": "^0.7.2",
    "axios": "^1.12.2",
    "camelcase-keys": "^10.0.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "codemirror": "^6.0.2",
    "cron-parser": "^5.4.0",
    "cronstrue": "^3.9.0",
    "date-fns": "^4.1.0",
    "dotted-map": "^3.1.0",
    "framer-motion": "^12.23.26",
    "geist": "^1.5.1",
    "gsap": "^3.14.2",
    "is-ip": "^5.0.1",
    "js-yaml": "^4.1.0",
    "lottie-react": "^2.4.1",
    "mermaid": "^11.12.2",
    "motion": "^12.26.2",
    "next": "^15.5.9",
    "next-intl": "^4.6.1",
    "next-themes": "0.4.6",
    "nprogress": "^0.2.0",
    "ogl": "^1.0.11",
    "p5": "1.11.10",
    "postprocessing": "^6.38.2",
    "psl": "^1.15.0",
    "react": "19.1.2",
    "react-day-picker": "^9.11.2",
    "react-dom": "19.1.2",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.65.0",
    "react-resizable-panels": "^4.6.5",
    "react-simple-maps": "3.0.0",
    "recharts": "2.15.4",
    "snakecase-keys": "^9.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "three": "^0.167.1",
    "tldts": "^6.1.86",
    "validator": "^13.15.15",
    "world-atlas": "2.0.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.58.2",
    "@storybook/addon-a11y": "10.4.1",
    "@storybook/nextjs-vite": "10.4.1",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.19",
    "@types/nprogress": "^0.2.3",
    "@types/p5": "^1.7.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.182.0",
    "@types/validator": "^13.15.3",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9",
    "eslint-config-next": "15.5.7",
    "jsdom": "^28.0.0",
    "msw": "^2.11.6",
    "msw-storybook-addon": "2.0.7",
    "storybook": "10.4.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
